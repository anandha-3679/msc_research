   "source": [
    "# =============================================================================\n",
    "# TEST 1: FEATURE SELECTION FREQUENCY\n",
    "# =============================================================================\n",
    "\n",
    "selection_frequency = []\n",
    "\n",
    "for method in stability_df[\"Method\"].unique():\n",
    "\n",
    "    for top_k in sorted(stability_df[\"Top_K\"].unique()):\n",
    "\n",
    "        subset = stability_df[\n",
    "            (stability_df[\"Method\"] == method) &\n",
    "            (stability_df[\"Top_K\"] == top_k)\n",
    "        ]\n",
    "\n",
    "        total_runs = len(subset)\n",
    "\n",
    "        all_features = sorted(\n",
    "            set().union(*subset[\"Feature_Set\"])\n",
    "        )\n",
    "\n",
    "        for feature in all_features:\n",
    "\n",
    "            selected_count = sum(\n",
    "                feature in feature_set\n",
    "                for feature_set in subset[\"Feature_Set\"]\n",
    "            )\n",
    "\n",
    "            selection_frequency.append({\n",
    "                \"Method\": method,\n",
    "                \"Top_K\": top_k,\n",
    "                \"Feature\": feature,\n",
    "                \"Selected_Count\": selected_count,\n",
    "                \"Total_Runs\": total_runs,\n",
    "                \"Selection_Frequency_Percentage\": (\n",
    "                    selected_count / total_runs\n",
    "                ) * 100\n",
    "            })\n",
    "\n",
    "selection_frequency_df = pd.DataFrame(selection_frequency)\n",
    "\n",
    "selection_frequency_df = selection_frequency_df.sort_values(\n",
    "    by=[\n",
    "        \"Method\",\n",
    "        \"Top_K\",\n",
    "        \"Selection_Frequency_Percentage\"\n",
    "    ],\n",
    "    ascending=[True, True, False]\n",
    ").reset_index(drop=True)\n",
    "\n",
    "display(selection_frequency_df)"
   ]
  },
