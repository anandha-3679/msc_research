    "                y_pred\n",
    "            ),\n",
    "\n",
    "            \"F1 Score\": f1_score(\n",
    "                y_test,\n",
    "                y_pred\n",
    "            ),\n",
    "\n",
    "            \"ROC-AUC\": roc_auc_score(\n",
