    "\n",
    "            {\n",
    "\n",
    "                \"Feature\": feature,\n",
    "\n",
    "                \"Selection_Count\": count,\n",
    "\n",
    "                \"Selection_Frequency\":\n",
    "                    count /\n",
    "                    len(selected_feature_sets)\n",
    "\n",
    "            }\n",
    "\n",
    "            for feature, count\n",
    "            in feature_counts.items()\n",
    "\n",
    "        ]\n",
    "\n",
    "    ).sort_values(\n",
    "\n",
    "        \"Selection_Frequency\",\n",
    "\n",
    "        ascending=False\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
