   "source": [
    "# =============================================================================\n",
    "# REPEATED STRATIFIED CROSS-VALIDATION\n",
    "# =============================================================================\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from sklearn.base import clone\n",
    "from sklearn.model_selection import RepeatedStratifiedKFold\n",
    "from sklearn.impute import SimpleImputer\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from xgboost import XGBClassifier\n",
    "\n",
    "from sklearn.metrics import (\n",
    "    accuracy_score,\n",
    "    precision_score,\n",
    "    recall_score,\n",
    "    f1_score,\n",
    "    roc_auc_score\n",
    ")\n",
    "\n",
    "\n",
    "from doda import DODASelector\n",
    "from doda.adapters.sklearn_adapter import SklearnAdapter\n",
    "from doda.knowledge import JSONProvider\n",
    "from doda.fusion import RankFusion\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# CONFIGURATION\n",
    "# =============================================================================\n",
    "\n",
    "TOP_K_VALUES = [5, 10, 15, 20]\n",
    "\n",
    "N_SPLITS = 5\n",
    "N_REPEATS = 5\n",
    "RANDOM_STATE = 42\n",
    "\n",
    "target_column = \"Diabetes_binary\"\n",
    "\n",
    "X = df.drop(columns=[target_column])\n",
    "y = df[target_column]\n",
    "\n",
    "feature_names = X.columns.tolist()\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# MODELS\n",
    "# =============================================================================\n",
    "\n",
    "models = {\n",
    "    \"Logistic Regression\": LogisticRegression(\n",
    "        max_iter=2000,\n",
    "        random_state=RANDOM_STATE\n",
    "    ),\n",
    "\n",
    "    \"Random Forest\": RandomForestClassifier(\n",
    "        n_estimators=300,\n",
    "        random_state=RANDOM_STATE,\n",
    "        n_jobs=-1\n",
    "    ),\n",
    "\n",
    "    \"XGBoost\": XGBClassifier(\n",
    "        n_estimators=300,\n",
    "        max_depth=3,\n",
    "        learning_rate=0.05,\n",
    "        subsample=0.8,\n",
    "        colsample_bytree=0.8,\n",
    "        eval_metric=\"logloss\",\n",
    "        random_state=RANDOM_STATE,\n",
    "        n_jobs=-1\n",
    "    )\n",
    "}\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# CLINICAL KNOWLEDGE PROVIDER\n",
    "# =============================================================================\n",
    "\n",
    "provider = JSONProvider(\n",
    "    \"clinical_weights.json\"\n",
    ")\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# REPEATED STRATIFIED CROSS-VALIDATION\n",
    "# =============================================================================\n",
    "\n",
    "cv = RepeatedStratifiedKFold(\n",
    "    n_splits=N_SPLITS,\n",
    "    n_repeats=N_REPEATS,\n",
    "    random_state=RANDOM_STATE\n",
    ")\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# RESULTS STORAGE\n",
    "# =============================================================================\n",
    "\n",
    "results = []\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# CROSS-VALIDATION LOOP\n",
    "# =============================================================================\n",
    "\n",
    "for run_number, (train_idx, test_idx) in enumerate(\n",
    "    cv.split(X, y),\n",
    "    start=1\n",
    "):\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 80)\n",
    "    print(f\"REPEATED STRATIFIED CV RUN {run_number}\")\n",
    "    print(\"=\" * 80)\n",
    "\n",
    "    X_train = X.iloc[train_idx].copy()\n",
    "    X_test = X.iloc[test_idx].copy()\n",
    "\n",
    "    y_train = y.iloc[train_idx].copy()\n",
    "    y_test = y.iloc[test_idx].copy()\n",
    "\n",
    "\n",
    "    # =========================================================================\n",
    "    # IMPUTATION\n",
    "    # =========================================================================\n",
    "\n",
    "    imputer = SimpleImputer(\n",
    "        strategy=\"median\"\n",
    "    )\n",
    "\n",
    "    X_train_imp_array = imputer.fit_transform(\n",
    "        X_train\n",
    "    )\n",
    "\n",
    "    X_test_imp_array = imputer.transform(\n",
    "        X_test\n",
    "    )\n",
    "\n",
    "    X_train_imp = pd.DataFrame(\n",
    "        X_train_imp_array,\n",
    "        columns=feature_names,\n",
    "        index=X_train.index\n",
    "    )\n",
    "\n",
    "    X_test_imp = pd.DataFrame(\n",
    "        X_test_imp_array,\n",
    "        columns=feature_names,\n",
    "        index=X_test.index\n",
    "    )\n",
    "\n",
    "\n",
    "    # =========================================================================\n",
    "    # FEATURE SELECTION FOR EACH TOP-K VALUE\n",
    "    # =========================================================================\n",
    "\n",
    "    for top_k in TOP_K_VALUES:\n",
    "\n",
    "        print(\"\\n\" + \"-\" * 80)\n",
    "        print(f\"TOP-K = {top_k}\")\n",
    "        print(\"-\" * 80)\n",
    "\n",
    "\n",
    "        # =====================================================================\n",
    "        # BASELINE LASSO FEATURE SELECTION\n",
    "        # =====================================================================\n",
    "\n",
    "        # Standardization is performed only using training data.\n",
    "        # This is important because LASSO is scale-sensitive.\n",
    "\n",
    "        lasso_scaler = StandardScaler()\n",
    "\n",
    "        X_train_lasso_scaled = lasso_scaler.fit_transform(\n",
    "            X_train_imp\n",
    "        )\n",
    "\n",
    "        X_test_lasso_scaled = lasso_scaler.transform(\n",
    "            X_test_imp\n",
    "        )\n",
    "\n",
    "        lasso_model = LogisticRegression(\n",
    "            penalty=\"l1\",\n",
    "            solver=\"liblinear\",\n",
    "            C=0.1,\n",
    "            max_iter=2000,\n",
    "            random_state=RANDOM_STATE\n",
    "        )\n",
    "\n",
    "        lasso_model.fit(\n",
    "            X_train_lasso_scaled,\n",
    "            y_train\n",
    "        )\n",
    "\n",
    "        lasso_coefficients = np.abs(\n",
    "            lasso_model.coef_[0]\n",
    "        )\n",
    "\n",
    "        lasso_ranked_indices = np.argsort(\n",
    "            lasso_coefficients\n",
    "        )[::-1]\n",
    "\n",
    "        lasso_selected_indices = (\n",
    "            lasso_ranked_indices[:top_k]\n",
    "        )\n",
    "\n",
    "        lasso_features = [\n",
    "            feature_names[i]\n",
    "            for i in lasso_selected_indices\n",
    "        ]\n",
    "\n",
    "        print(\"LASSO-selected features:\")\n",
    "        print(lasso_features)\n",
    "\n",
    "\n",
    "        # =====================================================================\n",
    "        # DODA-LASSO FEATURE SELECTION\n",
    "        # =====================================================================\n",
    "\n",
    "        # DODA receives the L1 logistic-regression estimator directly.\n",
    "        # Do not wrap it inside SelectFromModel because the DODA adapter\n",
    "        # extracts the coef_ attribute from the estimator.\n",
    "\n",
    "        doda_lasso_scaler = StandardScaler()\n",
    "\n",
    "        X_train_doda_scaled_array = (\n",
    "            doda_lasso_scaler.fit_transform(\n",
    "                X_train_imp\n",
    "            )\n",
    "        )\n",
    "\n",
    "        X_test_doda_scaled_array = (\n",
    "            doda_lasso_scaler.transform(\n",
    "                X_test_imp\n",
    "            )\n",
    "        )\n",
    "\n",
    "        X_train_doda_scaled = pd.DataFrame(\n",
    "            X_train_doda_scaled_array,\n",
    "            columns=feature_names,\n",
    "            index=X_train_imp.index\n",
    "        )\n",
    "\n",
    "        X_test_doda_scaled = pd.DataFrame(\n",
    "            X_test_doda_scaled_array,\n",
    "            columns=feature_names,\n",
    "            index=X_test_imp.index\n",
    "        )\n",
    "\n",
    "        doda_lasso_estimator = LogisticRegression(\n",
    "            penalty=\"l1\",\n",
    "            solver=\"liblinear\",\n",
    "            C=0.1,\n",
    "            max_iter=2000,\n",
    "            random_state=RANDOM_STATE\n",
    "        )\n",
    "\n",
    "        lasso_operator = SklearnAdapter(\n",
    "            doda_lasso_estimator\n",
    "        )\n",
    "\n",
    "        doda_selector = DODASelector(\n",
    "            operators=[lasso_operator],\n",
    "            provider=provider,\n",
    "            fusion=RankFusion(),\n",
    "            top_k=top_k\n",
    "        )\n",
    "\n",
    "        doda_selector.fit(\n",
    "            X_train_doda_scaled,\n",
    "            y_train\n",
    "        )\n",
    "\n",
    "        doda_features = (\n",
    "            doda_selector.get_selected_features()\n",
    "        )\n",
    "\n",
    "        print(\"DODA-selected features:\")\n",
    "        print(doda_features)\n",
    "\n",
    "\n",
    "        # =====================================================================\n",
    "        # PREPARE SELECTED FEATURE MATRICES\n",
    "        # =====================================================================\n",
    "\n",
    "        X_train_lasso_selected = (\n",
    "            X_train_imp[lasso_features]\n",
    "        )\n",
    "\n",
    "        X_test_lasso_selected = (\n",
    "            X_test_imp[lasso_features]\n",
    "        )\n",
    "\n",
    "        X_train_doda_selected = (\n",
    "            X_train_imp[doda_features]\n",
    "        )\n",
    "\n",
    "        X_test_doda_selected = (\n",
    "            X_test_imp[doda_features]\n",
    "        )\n",
    "\n",
    "\n",
    "        # =====================================================================\n",
    "        # MODEL EVALUATION\n",
    "        # =====================================================================\n",
    "\n",
    "        selected_feature_sets = {\n",
    "            \"LASSO\": (\n",
    "                X_train_lasso_selected,\n",
    "                X_test_lasso_selected,\n",
    "                lasso_features\n",
    "            ),\n",
    "\n",
    "            \"DODA\": (\n",
    "                X_train_doda_selected,\n",
    "                X_test_doda_selected,\n",
    "                doda_features\n",
    "            )\n",
    "        }\n",
    "\n",
    "\n",
    "        for method, (\n",
    "            X_train_selected,\n",
    "            X_test_selected,\n",
    "            selected_features\n",
    "        ) in selected_feature_sets.items():\n",
    "\n",
    "            for model_name, model_template in models.items():\n",
    "\n",
    "                model = clone(\n",
    "                    model_template\n",
    "                )\n",
    "\n",
    "                X_train_model = X_train_selected.copy()\n",
    "                X_test_model = X_test_selected.copy()\n",
    "\n",
    "\n",
    "                # -------------------------------------------------------------\n",
    "                # Scale only Logistic Regression\n",
    "                # -------------------------------------------------------------\n",
    "\n",
    "                if model_name == \"Logistic Regression\":\n",
    "\n",
    "                    model_scaler = StandardScaler()\n",
    "\n",
    "                    X_train_model = (\n",
    "                        model_scaler.fit_transform(\n",
    "                            X_train_model\n",
    "                        )\n",
    "                    )\n",
    "\n",
    "                    X_test_model = (\n",
    "                        model_scaler.transform(\n",
    "                            X_test_model\n",
    "                        )\n",
    "                    )\n",
    "\n",
    "\n",
    "                # -------------------------------------------------------------\n",
    "                # Train model\n",
    "                # -------------------------------------------------------------\n",
    "\n",
    "                model.fit(\n",
    "                    X_train_model,\n",
    "                    y_train\n",
    "                )\n",
    "\n",
    "                y_pred = model.predict(\n",
    "                    X_test_model\n",
    "                )\n",
    "\n",
    "                y_prob = model.predict_proba(\n",
    "                    X_test_model\n",
    "                )[:, 1]\n",
    "\n",
    "\n",
    "                # -------------------------------------------------------------\n",
    "                # Calculate metrics\n",
    "                # -------------------------------------------------------------\n",
    "\n",
    "                accuracy = accuracy_score(\n",
    "                    y_test,\n",
    "                    y_pred\n",
    "                )\n",
    "\n",
    "                precision = precision_score(\n",
    "                    y_test,\n",
    "                    y_pred,\n",
    "                    zero_division=0\n",
    "                )\n",
    "\n",
    "                recall = recall_score(\n",
    "                    y_test,\n",
    "                    y_pred,\n",
    "                    zero_division=0\n",
    "                )\n",
    "\n",
    "                f1 = f1_score(\n",
    "                    y_test,\n",
    "                    y_pred,\n",
    "                    zero_division=0\n",
    "                )\n",
    "\n",
    "                roc_auc = roc_auc_score(\n",
    "                    y_test,\n",
    "                    y_prob\n",
    "                )\n",
    "\n",
    "\n",
    "                # -------------------------------------------------------------\n",
    "                # Store results\n",
    "                # -------------------------------------------------------------\n",
    "\n",
