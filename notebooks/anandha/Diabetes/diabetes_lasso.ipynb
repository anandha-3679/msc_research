   "source": [
    "# =============================================================================\n",
    "# TEST 3: KUNCHEVA INDEX\n",
    "# =============================================================================\n",
    "\n",
    "TOTAL_FEATURES = 13\n",
    "\n",
    "kuncheva_results = []\n",
    "\n",
    "for method in stability_df[\"Method\"].unique():\n",
    "\n",
    "    for top_k in sorted(stability_df[\"Top_K\"].unique()):\n",
    "\n",
    "        subset = stability_df[\n",
    "            (stability_df[\"Method\"] == method) &\n",
    "            (stability_df[\"Top_K\"] == top_k)\n",
    "        ].reset_index(drop=True)\n",
    "\n",
    "        feature_sets = subset[\"Feature_Set\"].tolist()\n",
    "\n",
    "        pairwise_scores = []\n",
    "\n",
    "        for set_a, set_b in combinations(feature_sets, 2):\n",
    "\n",
    "            k_a = len(set_a)\n",
    "            k_b = len(set_b)\n",
    "\n",
    "            # Skip pairs with different numbers of selected features\n",
    "            if k_a != k_b:\n",
    "                continue\n",
    "\n",
    "            k = k_a\n",
    "\n",
    "            # Kuncheva index is undefined for empty or complete feature sets\n",
    "            if k == 0 or k >= TOTAL_FEATURES:\n",
    "                continue\n",
    "\n",
    "            common_features = len(set_a.intersection(set_b))\n",
    "\n",
    "            expected_overlap = (k * k) / TOTAL_FEATURES\n",
    "\n",
    "            denominator = k - expected_overlap\n",
    "\n",
    "            if denominator == 0:\n",
    "                continue\n",
    "\n",
    "            kuncheva_score = (\n",
    "                common_features - expected_overlap\n",
    "            ) / denominator\n",
    "\n",
    "            pairwise_scores.append(kuncheva_score)\n",
    "\n",
    "        if len(pairwise_scores) == 0:\n",
    "\n",
    "            kuncheva_results.append({\n",
    "                \"Method\": method,\n",
    "                \"Top_K\": top_k,\n",
    "                \"Mean_Kuncheva\": np.nan,\n",
    "                \"Std_Kuncheva\": np.nan,\n",
    "                \"Minimum_Kuncheva\": np.nan,\n",
    "                \"Maximum_Kuncheva\": np.nan,\n",
    "                \"Valid_Pair_Count\": 0\n",
    "            })\n",
    "\n",
    "        else:\n",
    "\n",
    "            kuncheva_results.append({\n",
    "                \"Method\": method,\n",
    "                \"Top_K\": top_k,\n",
    "                \"Mean_Kuncheva\": np.mean(pairwise_scores),\n",
    "                \"Std_Kuncheva\": (\n",
    "                    np.std(pairwise_scores, ddof=1)\n",
    "                    if len(pairwise_scores) > 1\n",
    "                    else 0.0\n",
    "                ),\n",
    "                \"Minimum_Kuncheva\": np.min(pairwise_scores),\n",
    "                \"Maximum_Kuncheva\": np.max(pairwise_scores),\n",
    "                \"Valid_Pair_Count\": len(pairwise_scores)\n",
    "            })\n",
    "\n",
    "kuncheva_df = pd.DataFrame(kuncheva_results)\n",
    "\n",
    "display(kuncheva_df)"
   ]
  },
