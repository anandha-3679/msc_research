   "source": [
    "# =============================================================================\n",
    "# LASSO + DODA MODEL EVALUATION\n",
    "# =============================================================================\n",
    "\n",
    "from sklearn.metrics import (\n",
    "    accuracy_score,\n",
    "    precision_score,\n",
    "    recall_score,\n",
    "    f1_score,\n",
    "    roc_auc_score\n",
    ")\n",
    "\n",
    "\n",
    "# -------------------------------------------------------------------------\n",
    "# Store results\n",
    "# -------------------------------------------------------------------------\n",
    "\n",
    "lasso_doda_model_results = []\n",
    "\n",
    "\n",
    "# -------------------------------------------------------------------------\n",
    "# Evaluate for each Top-K\n",
    "# -------------------------------------------------------------------------\n",
    "\n",
    "for k in k_values:\n",
    "\n",
    "    Xtr = doda_results[k][\"X_train\"]\n",
    "\n",
    "    Xts = doda_results[k][\"X_test\"]\n",
    "\n",
    "    features = \", \".join(\n",
    "        doda_results[k][\"features\"]\n",
    "    )\n",
    "\n",
    "\n",
    "    # ---------------------------------------------------------------------\n",
    "    # Evaluate each model\n",
    "    # ---------------------------------------------------------------------\n",
    "\n",
    "    for model_name, model in models.items():\n",
    "\n",
    "        # Train model\n",
    "        model.fit(\n",
    "            Xtr,\n",
    "            y_train\n",
    "        )\n",
    "\n",
    "\n",
    "        # Predictions\n",
    "        y_pred = model.predict(\n",
    "            Xts\n",
    "        )\n",
    "\n",
    "\n",
    "        # Probability predictions\n",
    "        y_prob = model.predict_proba(\n",
    "            Xts\n",
    "        )[:, 1]\n",
    "\n",
    "\n",
    "        # ---------------------------------------------------------------\n",
    "        # Store evaluation metrics\n",
    "        # ---------------------------------------------------------------\n",
    "\n",
    "        lasso_doda_model_results.append({\n",
    "\n",
    "            \"Method\": \"LASSO + DODA\",\n",
    "\n",
    "            \"Top-K\": k,\n",
    "\n",
    "            \"Model\": model_name,\n",
    "\n",
    "            \"Selected Features\": features,\n",
    "\n",
    "            \"Accuracy\": accuracy_score(\n",
    "                y_test,\n",
    "                y_pred\n",
    "            ),\n",
    "\n",
    "            \"Precision\": precision_score(\n",
    "                y_test,\n",
    "                y_pred,\n",
    "                zero_division=0\n",
    "            ),\n",
    "\n",
    "            \"Recall\": recall_score(\n",
    "                y_test,\n",
    "                y_pred,\n",
    "                zero_division=0\n",
    "            ),\n",
    "\n",
    "            \"F1 Score\": f1_score(\n",
    "                y_test,\n",
    "                y_pred,\n",
    "                zero_division=0\n",
    "            ),\n",
    "\n",
    "            \"ROC-AUC\": roc_auc_score(\n",
    "                y_test,\n",
    "                y_prob\n",
    "            )\n",
    "        })\n",
    "\n",
    "\n",
    "# -------------------------------------------------------------------------\n",
    "# Convert results to DataFrame\n",
    "# -------------------------------------------------------------------------\n",
    "\n",
    "lasso_doda_results_df = pd.DataFrame(\n",
    "    lasso_doda_model_results\n",
    ")\n",
    "\n",
    "\n",
    "# -------------------------------------------------------------------------\n",
    "# Display results\n",
    "# -------------------------------------------------------------------------\n",
    "\n",
    "display(\n",
    "    lasso_doda_results_df\n",
    ")"
   ]
  },
