    "# =============================================================================\n",
    "# TEST 2: PAIRWISE JACCARD SIMILARITY\n",
    "# =============================================================================\n",
    "\n",
    "jaccard_results = []\n",
    "\n",
    "for method in stability_df[\"Method\"].unique():\n",
    "\n",
    "    for top_k in sorted(stability_df[\"Top_K\"].unique()):\n",
    "\n",
    "        subset = stability_df[\n",
    "            (stability_df[\"Method\"] == method) &\n",
    "            (stability_df[\"Top_K\"] == top_k)\n",
    "        ].reset_index(drop=True)\n",
    "\n",
    "        feature_sets = subset[\"Feature_Set\"].tolist()\n",
    "\n",
    "        pairwise_scores = []\n",
    "\n",
    "        for set_a, set_b in combinations(feature_sets, 2):\n",
    "\n",
    "            intersection_size = len(set_a.intersection(set_b))\n",
    "            union_size = len(set_a.union(set_b))\n",
    "\n",
    "            if union_size == 0:\n",
    "                jaccard_score = 1.0\n",
    "            else:\n",
    "                jaccard_score = intersection_size / union_size\n",
    "\n",
    "            pairwise_scores.append(jaccard_score)\n",
    "\n",
    "        jaccard_results.append({\n",
    "            \"Method\": method,\n",
    "            \"Top_K\": top_k,\n",
    "            \"Mean_Jaccard\": np.mean(pairwise_scores),\n",
    "            \"Std_Jaccard\": np.std(pairwise_scores, ddof=1),\n",
    "            \"Minimum_Jaccard\": np.min(pairwise_scores),\n",
    "            \"Maximum_Jaccard\": np.max(pairwise_scores)\n",
    "        })\n",
    "\n",
    "jaccard_df = pd.DataFrame(jaccard_results)\n",
    "\n",
    "display(jaccard_df)"
   ]
  },
