    "# =============================================================================\n",
    "# TEST 4: LASSO VS DODA FEATURE-SET AGREEMENT\n",
    "# =============================================================================\n",
    "\n",
    "agreement_results = []\n",
    "\n",
    "for run in sorted(stability_df[\"Run\"].unique()):\n",
    "\n",
    "    for top_k in sorted(stability_df[\"Top_K\"].unique()):\n",
    "\n",
    "        lasso_rows = stability_df[\n",
    "            (stability_df[\"Run\"] == run) &\n",
    "            (stability_df[\"Method\"] == \"LASSO\") &\n",
    "            (stability_df[\"Top_K\"] == top_k)\n",
    "        ]\n",
    "\n",
    "        doda_rows = stability_df[\n",
    "            (stability_df[\"Run\"] == run) &\n",
    "            (stability_df[\"Method\"] == \"DODA\") &\n",
    "            (stability_df[\"Top_K\"] == top_k)\n",
    "        ]\n",
    "\n",
    "        if lasso_rows.empty or doda_rows.empty:\n",
    "            continue\n",
    "\n",
    "        lasso_set = lasso_rows.iloc[0][\"Feature_Set\"]\n",
    "        doda_set = doda_rows.iloc[0][\"Feature_Set\"]\n",
    "\n",
    "        intersection_size = len(lasso_set.intersection(doda_set))\n",
    "        union_size = len(lasso_set.union(doda_set))\n",
    "\n",
    "        if union_size == 0:\n",
    "            jaccard_agreement = 1.0\n",
    "        else:\n",
    "            jaccard_agreement = intersection_size / union_size\n",
    "\n",
    "        agreement_results.append({\n",
    "            \"Run\": run,\n",
    "            \"Top_K\": top_k,\n",
    "            \"LASSO_Features\": \", \".join(sorted(lasso_set)),\n",
    "            \"DODA_Features\": \", \".join(sorted(doda_set)),\n",
    "            \"Common_Feature_Count\": intersection_size,\n",
    "            \"LASSO_Feature_Count\": len(lasso_set),\n",
    "            \"DODA_Feature_Count\": len(doda_set),\n",
    "            \"Same_Feature_Set\": lasso_set == doda_set,\n",
    "            \"Jaccard_Agreement\": jaccard_agreement\n",
    "        })\n",
    "\n",
    "agreement_df = pd.DataFrame(agreement_results)\n",
    "\n",
    "display(agreement_df)"
   ]
  },
