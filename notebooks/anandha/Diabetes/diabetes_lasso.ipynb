   "source": [
    "# =============================================================================\n",
    "# PREPARE FEATURE SETS FOR STABILITY ANALYSIS\n",
    "# =============================================================================\n",
    "\n",
    "import ast\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from itertools import combinations\n",
    "\n",
    "\n",
    "def convert_to_set(features):\n",
    "    \"\"\"\n",
    "    Convert Selected_Features into a Python set.\n",
    "    Handles lists, tuples, NumPy arrays, and strings.\n",
    "    \"\"\"\n",
    "\n",
    "    if isinstance(features, str):\n",
    "\n",
    "        # Handle string representation of a list\n",
    "        if features.startswith(\"[\") and features.endswith(\"]\"):\n",
    "            try:\n",
    "                features = ast.literal_eval(features)\n",
    "            except Exception:\n",
    "                features = features.split(\",\")\n",
    "\n",
    "        else:\n",
    "            features = features.split(\",\")\n",
    "\n",
    "    return {\n",
    "        str(feature).strip().strip(\"'\").strip('\"')\n",
    "        for feature in features\n",
    "        if str(feature).strip()\n",
    "    }\n",
    "\n",
    "\n",
    "# Use only one model because feature selection is independent of evaluation model\n",
    "stability_df = results_df[\n",
    "    results_df[\"Model\"] == \"Logistic Regression\"\n",
    "].copy()\n",
    "\n",
    "stability_df[\"Feature_Set\"] = stability_df[\"Selected_Features\"].apply(\n",
    "    convert_to_set\n",
    ")\n",
    "\n",
    "print(\"Rows used for stability analysis:\", len(stability_df))\n",
    "print(stability_df[[\"Run\", \"Method\", \"Top_K\", \"Feature_Set\"]].head())"
   ]
  },
